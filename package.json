{
  "name": "lemonless",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation preview: a clear verdict on a used-car listing, plus a paid agent API for the same verdict.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/eval-free-llm-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "tsx test/golden/cli.ts",
    "check:run": "tsx scripts/check-run.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "test:acceptance:find-radar-serv": "vitest run src/server/find-radar-serv-acceptance.test.ts",
    "test:e2e:find-radar-http": "bash scripts/e2e-find-radar-ci.sh",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:full-report": "npm audit --audit-level=high",
    "boundary:source": "node scripts/assert-openserv-source-boundary.mjs",
    "boundary:next": "node scripts/assert-no-openserv-in-next-server.mjs",
    "eval:find-baseline": "tsx eval/find-baseline.ts",
    "eval:serv": "tsx eval/run.ts",
    "eval:verdict": "tsx eval/verdict-run.ts",
    "eval:trace": "tsx eval/trace.ts",
    "eval:comparison": "tsx eval/comparison/harness.ts",
    "eval:snapshot": "tsx eval/snapshot/harness.ts",
    "eval:record-serv-revision": "tsx eval/record-serv-revision.ts",
    "eval:live": "tsx eval/live/harness.ts",
    "test:hero-scrub": "node scripts/hero-scrub-scroll.mjs",
    "smoke:free-gov": "node scripts/free-gov-smoke.mjs",
    "probe:listing-fetch": "tsx scripts/probe-listing-fetch.ts",
    "probe:serv-tools": "tsx scripts/probe-serv-tools.ts",
    "eval:serv-vs-baseline": "tsx scripts/eval-serv-vs-baseline.ts --dry-run",
    "replay:choose-car-messy": "tsx scripts/replay-choose-car-messy.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "gsap": "^3.15.1",
    "jose": "^6.2.16",
    "lenis": "^1.3.27",
    "next": "^15.5.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0",
    "@x402/core": "2.31.0",
    "@x402/evm": "2.31.0",
    "@x402/extensions": "2.31.0"
  },
  "devDependencies": {
    "@openserv-labs/sdk": "^2.4.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "nodemailer": "10.4.0",
    "@grpc/grpc-js": "1.14.7"
  }
}
