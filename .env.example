# Auto.dev free plan. Listings only. Never commit a real key.
AUTODEV_API_KEY=

# OpenServ SERV Reasoning. Used to screen input and explain computed numbers.
SERV_API_KEY=
# Optional. Default gpt-5.4-mini.
SERV_MODEL=gpt-5.4-mini
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Stripe TEST MODE only. Live keys (sk_live_) are refused by the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (next-auth). Paid checkout fails closed until AUTH_SECRET and at least one provider are set.
# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth (https://authjs.dev/getting-started/providers/google). Callback: {APP}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Passwordless email via Firebase Authentication email link (Spark). Public web config, not a secret.
# The email option on /login appears only when all four are set. Firebase sends the message; no SMTP.
# The link returns to {origin}/login/finish, so that host must be a Firebase authorized domain.
# Public project lemonless: apiKey AIzaSyCRHfYBk4p9lN-UWEUdWdKjrql4jQEv4AY,
# authDomain lemonless.firebaseapp.com, projectId lemonless,
# appId 1:154650919449:web:cf93c20226a554ca652088
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional one-time starting balance for local evaluation. Unset in any shared deploy.
# AUTOFLIP_DEV_CREDITS=3

# Shared preview. /demo?key= must match. Balance is reset to DEMO_CREDITS once per UTC day.
DEMO_ACCESS_KEY=
DEMO_CREDITS=5

# GitHub Actions calls POST /api/radar/cron with Authorization: Bearer this secret.
RADAR_CRON_SECRET=

# Free persistent store. Required on Vercel. Locally, .data/kv.json is used when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Product surface flags. Defaults: resale ON, Deal Radar ON.
# RESALE_EVALUATE_ENABLED=false turns off /resale. DEAL_RADAR_UI_ENABLED=false hides /radar.
RESALE_EVALUATE_ENABLED=
DEAL_RADAR_UI_ENABLED=

# Where quota, cache, credits, and reports are stored.
# On Vercel the default is /tmp/autoflip (ephemeral). For a real launch, point this
# at a persistent disk or replace the file store.
AUTOFLIP_DATA_DIR=
