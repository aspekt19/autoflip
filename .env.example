# Auto.dev free plan. Listings only. Never commit a real key.
AUTODEV_API_KEY=

# OpenServ SERV Reasoning. Used to screen input and explain computed numbers.
SERV_API_KEY=
# Optional. Default gpt-5.4-mini.
SERV_MODEL=gpt-5.4-mini
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Stripe TEST MODE only. Live keys (sk_live_) are refused by the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional one-time starting balance for local evaluation. Unset in any shared deploy.
# AUTOFLIP_DEV_CREDITS=3

# Shared preview. /demo?key= must match. Balance is reset to DEMO_CREDITS once per UTC day.
DEMO_ACCESS_KEY=
DEMO_CREDITS=5

# GitHub Actions calls POST /api/radar/cron with Authorization: Bearer this secret.
RADAR_CRON_SECRET=

# Free persistent store. Required on Vercel. Locally, .data/kv.json is used when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram. All three are required before alerts leave the app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Testnet-only payment for each radar run. All of these must be set, and X402_NETWORK must be kite-testnet.
# If any are missing, the run log says not configured and does not invent a transaction.
KITE_PASSPORT_BASE_URL=
KITE_SESSION_ID=
KITE_SESSION_TOKEN=

# Where quota, cache, credits, and reports are stored.
# On Vercel the default is /tmp/autoflip (ephemeral). For a real launch, point this
# at a persistent disk or replace the file store.
AUTOFLIP_DATA_DIR=

# Agent API payment (x402). Leave PAY_TO empty until you are ready to accept payment.
# The app never invents a successful payment.
X402_PAY_TO=
X402_SCHEME=gokite-aa
X402_NETWORK=kite-testnet
X402_ASSET=
X402_FACILITATOR_URL=https://facilitator.pieverse.io
# Atomic units of X402_ASSET. 1000000 = 1.00 when the asset has 6 decimals.
X402_PRICE_ATOMIC=1000000
X402_TIMEOUT_SECONDS=120
# Extra description shown to the paying agent. No default mentions a consumer brand beyond AutoFlip.
X402_DESCRIPTION=AutoFlip full vehicle report

# --- Lemonless Scout (default OFF; owner-only live path) ---
# API surface. Independent of UI.
SCOUT_ENABLED=
# Minimal /scout page. Does not enable POST by itself.
SCOUT_UI_ENABLED=
# Master switch for live Autodev/SERV. Still needs owner allowlist + Upstash + ceiling.
SCOUT_PAID_EXECUTION=
# Hard ceiling on provider calls per authorization window (required for live).
SCOUT_MAX_PROVIDER_CALLS_HARD_CEILING=
# Comma-separated Lemonless userIds (from af_ key ownership). Required for live authority.
SCOUT_OWNER_USER_IDS=
# Optional per-run call cap for owner live path (default 3). Not a balance grant.
SCOUT_OWNER_MAX_PROVIDER_CALLS_PER_RUN=
# Bounded SERV planner (search/check/replan). Requires paid authority + SERV_API_KEY.
SCOUT_ALLOW_SERV_PLANNER=
# DIAGNOSTIC ONLY — never treated as a spend grant:
# SCOUT_SERVER_VERIFIED_BALANCE_USD=
# SCOUT_SERVER_SPEND_HARD_CAP_USD=
